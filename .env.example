# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# Публичный HTTPS-адрес сервера
PUBLIC_BASE_URL=https://example.ngrok.app
CALL_API_KEY=replace-with-a-long-random-secret
PORT=5050

COMPANY_NAME=Спецавтотехника
AGENT_NAME=Алексей
DEFAULT_CALL_PURPOSE=Рассказать о продукции САТ, выяснить потребность клиента, ответить на вопросы и определить следующий шаг.

# Ограничения обзвона
MAX_CONCURRENT_CALLS=3
ALLOWED_PHONE_PREFIXES=+375,+7
DRY_RUN=true
CAMPAIGN_DELAY_MS=3000

# Единственный источник данных о продукции
CATALOG_URL=https://www.satpricep.by/catalog/filter/clear/apply/
CATALOG_MAX_AGE_HOURS=6
CATALOG_MAX_PAGES=20
CATALOG_MAX_PRODUCT_PAGES=200
# true = если свежий каталог получить нельзя, новые звонки не начинаются
REQUIRE_FRESH_CATALOG=true
